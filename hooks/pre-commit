#!/usr/bin/env bash
# Lint what is actually being committed, not the working tree: a staged hunk
# that fails clippy would otherwise sail through because the unstaged fix is
# still sitting on disk.
set -Eeuo pipefail

# A fixed path rather than `mktemp -d`, and its own target dir. Integration
# tests bake CARGO_BIN_EXE_* in at compile time, so building them somewhere
# that is then deleted leaves a cached test binary pointing at nothing — and
# sharing the developer's target/ hands them that corpse on their next
# `cargo test`. Everything here lives under target/, which is already ignored.
work="$PWD/target/pre-commit"
rm -rf "$work"
mkdir -p "$work"

git checkout-index --all --prefix="$work/"

cd "$work"
export CARGO_TARGET_DIR="$work/target"
nix develop "$OLDPWD" --command sh -c '
  set -e
  cargo fmt --all --check
  cargo clippy --all-targets --locked -- -D warnings
  cargo test --locked --quiet
'
